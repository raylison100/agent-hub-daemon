{
  "name": "agent-hub-daemon",
  "version": "0.1.0",
  "description": "Servico local do Agent Hub: sessoes, runs, ferramentas, aprovacoes e API WebSocket",
  "type": "module",
  "bin": {
    "agent-hub-daemon": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js start"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agent-hub/core": "link:../core",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "croner": "^10.0.1",
    "fastify": "^5.12.3",
    "smol-toml": "^1.8.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
